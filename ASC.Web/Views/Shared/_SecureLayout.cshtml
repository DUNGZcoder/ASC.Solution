@using Microsoft.AspNetCore.Http
@using ASC.Utilities
@using ASC.Web.Data
@inject IHttpContextAccessor UserHttpContext
@inject INavigationCacheOperations navigationCache

@{
    Layout = "_MasterLayout";

    var currentUser =
        UserHttpContext.HttpContext.User.GetCurrentUserDetails();
}

<!-- Header -->
<header class="secureLayout">

    <nav class="top-nav blue-grey lighten-1">

        <div class="nav-wrapper row valign-wrapper">

            <div class="col s12 valign-wrapper">

                <a href="#"
                   data-target="nav-mobile"
                   class="sidenav-trigger">

                    <i class="material-icons">menu</i>

                </a>

                <span class="page-title white-text">
                    Automobile Service Center
                </span>

            </div>

        </div>

    </nav>

    <!-- Side NavBar -->
    <ul id="nav-mobile" class="sidenav sidenav-fixed collapsible">

        <li>

            <div class="user-view">

                <div class="background blue-grey lighten-1"></div>

                <a href="#!user">
                    <img class="circle"
                         src="~/images/male.png" />
                </a>

                <a href="#!name">
                    <span class="white-text name">
                        @currentUser.Name
                    </span>
                </a>

                <a href="#!email">
                    <span class="white-text email">
                        @currentUser.Email
                    </span>
                </a>

            </div>

        </li>

        @await Component.InvokeAsync(
                 "ASC.Web.Navigation.LeftNavigation",
                 await navigationCache.GetNavigationCacheAsync())

    </ul>

</header>

<!-- Main -->
<main class="secureLayout">

    <div class="row margin-bottom-0px">

        <div class="col s12">
            @RenderBody()
        </div>

    </div>

</main>

<!-- Footer -->
<footer class="page-footer blue-grey lighten-1 secureLayout">

    <div class="container">

        <div class="row">

            <div class="col l6 s12">

                <h5 class="white-text">About Us</h5>

                <p class="grey-text text-lighten-4">

                    Automobile Service Center is certified Company
                    to perform car services.

                </p>

            </div>

            <div class="col l3 s12">

                <h5 class="white-text">
                    Additional Services
                </h5>

                <ul>

                    <li>
                        <a class="white-text" href="#!">
                            Services
                        </a>
                    </li>

                    <li>
                        <a class="white-text" href="#!">
                            Finance
                        </a>
                    </li>

                    <li>
                        <a class="white-text" href="#!">
                            Used Cars
                        </a>
                    </li>

                </ul>

            </div>

            <div class="col l3 s12">

                <h5 class="white-text">Connect</h5>

                <ul>

                    <li>
                        <a class="white-text" href="#!">
                            Facebook
                        </a>
                    </li>

                    <li>
                        <a class="white-text" href="#!">
                            LinkedIn
                        </a>
                    </li>

                    <li>
                        <a class="white-text" href="#!">
                            Twitter
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </div>

    <div class="footer-copyright row margin-bottom-0px">

        <div class="col s12">

            Powered by

            <a class="brown-text text-lighten-3"
               href="http://materializecss.com">

                Materialize

            </a>

        </div>

    </div>

</footer>

<form class="hide" method="post" id="logout_form"
      asp-area="Identity" asp-page="/Account/Logout">
    <input type="submit" value="Logout" />
</form>

<form class="hide" method="post" id="resetPassword_form"
      asp-area="Identity" asp-page="/Account/InitiateResetPassword">
</form>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {

            var elems = document.querySelectorAll('.collapsible');
            M.Collapsible.init(elems);

            var logout = document.getElementById("ancrLogout");
            var resetPassword = document.getElementById("ancrResetPassword");

            if (logout) {
                logout.addEventListener("click", function (e) {
                    e.preventDefault();
                    document.getElementById("logout_form").submit();
                });
            }

            if (resetPassword) {
                resetPassword.addEventListener("click", function (e) {
                    e.preventDefault();
                    document.getElementById("resetPassword_form").submit();
                });
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
}