@page
@using Microsoft.AspNetCore.Identity
@model ASC.Web.Areas.Identity.Pages.Account.LoginModel
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Log in";
}

<div class="container">
    <div class="row">

        <div class="col s12 m5 offset-m1">
            <form asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="row">
                    <div class="input-field col s12">
                        <input asp-for="Input.Email" type="email" class="validate" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="helper-text text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <input asp-for="Input.Password" type="password" class="validate" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="helper-text text-danger"></span>
                    </div>
                </div>

                <div class="row padding-left-10px">
                    <p>
                        <label>
                            <input asp-for="Input.RememberMe" type="checkbox" class="filled-in" />
                            <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                        </label>
                    </p>
                </div>

                <div class="row center">
                    <button class="btn waves-effect waves-light" type="submit">
                        Submit
                        <i class="material-icons right">send</i>
                    </button>
                </div>

                <div class="row center">
                    <a href="/Identity/Account/ForgotPassword">
                        Forgot your password?
                    </a>
                </div>

            </form>
        </div>

        <div class="col s12 m5 offset-m1">
            <h6>Login using External Providers.</h6>

            <div class="divider"></div>

            @{
                var loginProviders = await SignInManager.GetExternalAuthenticationSchemesAsync();

                if (loginProviders.Count() != 0)
                {
                    <form asp-area="Identity"
                          asp-page="/Account/ExternalLogin"
                          asp-route-returnUrl="@ViewData["ReturnUrl"]"
                          method="post"
                          class="form-horizontal">

                        <div class="row center margin-top-20px">
                            @foreach (var provider in loginProviders)
                            {
                                <button type="submit"
                                        class="btn waves-effect waves-light"
                                        name="provider"
                                        value="@provider.DisplayName"
                                        title="Log in using your @provider.DisplayName account">

                                    @provider.DisplayName
                                    <i class="material-icons right">account_circle</i>

                                </button>
                            }
                        </div>

                    </form>
                }
            }
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}